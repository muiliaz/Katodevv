# Editor defaults, so a file does not change shape depending on who opened it.
# Prettier (frontend/.prettierrc.json) is the enforcing half; this is the part
# that works before a file is ever saved.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
