# Environment contract for the Netlify Functions in netlify/functions/.
#
# Copy to .env for local `netlify dev`; .env is gitignored, this file is not.
# Never put real values here — this file is committed.
#
# In production these are NOT read from a file. Set them in the Netlify UI:
#   Site configuration -> Environment variables -> Add a variable
#   Scope: Functions
#
# Both are required. Without them the contact and lead endpoints answer 500
# and nothing reaches Telegram — see netlify/functions/lib/telegram.js.

# Bot token from @BotFather, in the form 123456789:AA...
# Read by lib/telegram.js to build the sendMessage URL.
TELEGRAM_TOKEN=

# Numeric id of the chat that receives the enquiries. Negative for groups
# (e.g. -1001234567890). To find it: add the bot to the chat, send any
# message, then open https://api.telegram.org/bot<TOKEN>/getUpdates and read
# result[].message.chat.id
TELEGRAM_CHAT_ID=

# Cloudflare Turnstile secret (the private half of the widget key pair).
# Read by netlify/functions/lib/turnstile.js.
#
# OPTIONAL BUT IMPORTANT: when it is absent the challenge is skipped and the
# forms still work, protected only by validation, the honeypot and the rate
# limiter. That is deliberate — a typo here must not silently destroy every
# enquiry — but it means an empty value is NOT the same as protected.
#
# In Netlify set it under Environment variables with scope Functions and mark
# it as a secret. The public site key lives in src/shared/Turnstile.jsx.
TURNSTILE_SECRET_KEY=
