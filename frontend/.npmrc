# Do not run dependencies' install scripts.
#
# dependency-hygiene DH-004: "Сейчас код пакетов выполняется во время установки
# без явного списка разрешений." A postinstall script runs with full access to
# the machine and the CI runner, and npm gives it that by default.
#
# Verified safe for this project: `npm ci --ignore-scripts` from a clean tree
# installs, builds and passes the whole suite. Nothing here needs a native
# build step — the heaviest dependencies (three, gsap) ship plain JavaScript.
#
# If a future dependency genuinely needs its script, allow that one explicitly
# rather than deleting this line.
ignore-scripts=true
